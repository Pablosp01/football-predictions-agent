# Free key from https://www.football-data.org/client/register
# Leave unset to use the bundled offline sample data.
FOOTBALL_DATA_API_KEY=

# Optional: if set, the API requires an X-API-Key header with this value
# on every endpoint except /health. Leave unset for open local use.
API_KEY=

# Port for `python -m football_agent.api` (Render/Fly set $PORT themselves).
PORT=8000
